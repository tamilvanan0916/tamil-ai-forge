# TAMIL AI FORGE — Environment Configuration Template
# All API keys must remain strictly server-side and never be committed to source control.

# Application
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./storage/tamil_ai_forge.db
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# AI Video Providers (Configure your real API key server-side)
VIDEO_PROVIDER=8scale  # 8scale | omni_factory | runway | luma

# Hugging Face Omni Video Factory (ZeroGPU)
HF_TOKEN=

EIGHTSCALE_API_KEY=
EIGHTSCALE_BASE_URL=https://8scale.run

RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1

LUMA_API_KEY=
LUMA_BASE_URL=https://api.lumalabs.ai/dream-machine/v1

KLING_API_KEY=

# Other AI Providers
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

IMAGE_PROVIDER=stability
STABILITY_API_KEY=
FLUX_API_KEY=

TTS_PROVIDER=google
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
ELEVENLABS_API_KEY=

STT_PROVIDER=whisper
LIP_SYNC_PROVIDER=wav2lip
SYNCLABS_API_KEY=
MUSIC_PROVIDER=musicgen

# Media Binaries (Leave blank for automatic virtualenv detection)
FFMPEG_PATH=
FFPROBE_PATH=
