# Environment variables for TAMIL AI FORGE

# App
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL default, or SQLite for zero-setup local dev)
# SQLite dev mode: sqlite+aiosqlite:///./storage/tamil_ai_forge.db
DATABASE_URL=sqlite+aiosqlite:///./storage/tamil_ai_forge.db
# PostgreSQL mode (uncomment for production or Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tamil_ai_forge

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
# S3 Configuration (future production)
S3_ENDPOINT=
S3_BUCKET=tamil-ai-forge
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Redis & Celery (optional in single-process dev mode, enabled in production)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Keys loaded server-side only - NEVER exposed to frontend)
# LLM Providers: openai | anthropic | google | local
LLM_PROVIDER=google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Image Generation Providers: stability | openai | flux | comfyui
IMAGE_PROVIDER=stability
STABILITY_API_KEY=
FLUX_API_KEY=

# Video Generation Providers: runway | kling | luma | stability
VIDEO_PROVIDER=runway
RUNWAY_API_KEY=
KLING_API_KEY=
LUMA_API_KEY=

# Text to Speech: google | azure | elevenlabs | coqui
TTS_PROVIDER=google
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Speech to Text: whisper | google | azure
STT_PROVIDER=whisper

# Lip Sync: wav2lip | synclabs | sadtalker
LIP_SYNC_PROVIDER=wav2lip
SYNCLABS_API_KEY=

# Music Generation: musicgen | stable_audio
MUSIC_PROVIDER=musicgen
